# The keys only the stack on Kubernetes reads, beside those of .env.example,
# filled the same way.

# --- Ingress ---
# INGRESS_CLASS: the class of the cluster's ingress controller, set on every
# Ingress. DMP_API_URL: the DMP API from outside the cluster, at its root, the
# host of its Ingress. The local values, the k3d cluster:
#   INGRESS_CLASS  traefik
#   DMP_API_URL    http://localhost:8090
INGRESS_CLASS=
DMP_API_URL=
