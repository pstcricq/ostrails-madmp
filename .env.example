# Every value of the repository, one section per part. A key with a value is
# fixed, changed by a commit. An empty key is filled where madmp runs: by
# ENV_FILE=<file> for the make targets, else by the environment.
#
# The local values are given beside each key. An empty key ending in _USER,
# _PASSWORD, _SECRET, _TOKEN or _PRIVATE_KEY is a secret.

# --- DMP database ---
# The PostgreSQL server of the DMPs, its database and the account that owns
# it, both existing beforehand. DMP_POSTGRES_VERSION: the image of the
# integration tests' server. The local values, a server on this machine:
#   DMP_HOST      localhost
#   DMP_PORT      5432
#   DMP_DB        dmp
#   DMP_USER      dmp_app
#   DMP_PASSWORD  openssl rand -hex 24
DMP_POSTGRES_VERSION=17.5
DMP_HOST=
DMP_PORT=
DMP_DB=
DMP_USER=
DMP_PASSWORD=

# --- DMP API ---
# The tokens a client sends as "Authorization: Bearer <token>":
# TEMPLATE_WRITE_TOKEN writes a template DMP, DMP_READ_TOKEN reads,
# DMP_WRITE_TOKEN writes the production DMPs and reads. The local values:
#   TEMPLATE_WRITE_TOKEN  openssl rand -hex 24
#   DMP_READ_TOKEN        openssl rand -hex 24
#   DMP_WRITE_TOKEN       openssl rand -hex 24
TEMPLATE_WRITE_TOKEN=
DMP_READ_TOKEN=
DMP_WRITE_TOKEN=

# --- DSW ---
# DSW_API_URL: the DS Wizard API, as madmp reaches it. DSW_USER, DSW_PASSWORD:
# the administrator madmp logs in as. SUBMISSION_URL: where DSW sends a
# submitted document, as DSW reaches it. The local values, a DSW on this
# machine:
#   DSW_API_URL     http://localhost:3000/wizard-api
#   DSW_USER        madmp-admin@example.com
#   DSW_PASSWORD    openssl rand -hex 24
#   SUBMISSION_URL  http://dmp-api:8081/templates
DSW_API_URL=
DSW_USER=
DSW_PASSWORD=
SUBMISSION_URL=
