# Every value of the repository, one section per part. A key with a value is
# fixed, changed by a commit. An empty key is filled where madmp runs: by
# ENV_FILE=<file> for the make targets, by deploy/docker/.env or
# deploy/kubernetes/.env for a stack, else by the environment. A target's own
# keys are in the .env.example of its directory under deploy/.
#
# The local values are given beside each key, under docker and under
# Kubernetes when they differ. An empty key ending in _USER, _PASSWORD,
# _SECRET, _TOKEN or _PRIVATE_KEY is a secret, printed as set only.

# --- DMP database ---
# The PostgreSQL server of the DMPs, its database and the account that owns
# it, both existing beforehand. DMP_POSTGRES_VERSION: the image of the stack's
# server and of the integration tests. The local values, a server on this
# machine:
#   DMP_HOST      localhost
#   DMP_PORT      5432
#   DMP_DB        dmp
#   DMP_USER      dmp_app
#   DMP_PASSWORD  openssl rand -hex 24
# Under docker and Kubernetes, the stack's own server:
#   DMP_HOST      dmp-postgres
DMP_POSTGRES_VERSION=17.5
DMP_HOST=
DMP_PORT=
DMP_DB=
DMP_USER=
DMP_PASSWORD=

# --- DMP API ---
# The tokens a client sends as "Authorization: Bearer <token>":
# TEMPLATE_WRITE_TOKEN writes a template DMP, DMP_READ_TOKEN reads,
# DMP_WRITE_TOKEN writes the production DMPs and reads. The local values:
#   TEMPLATE_WRITE_TOKEN  openssl rand -hex 24
#   DMP_READ_TOKEN        openssl rand -hex 24
#   DMP_WRITE_TOKEN       openssl rand -hex 24
TEMPLATE_WRITE_TOKEN=
DMP_READ_TOKEN=
DMP_WRITE_TOKEN=

# --- DSW ---
# DSW_API_URL: the DS Wizard API, as madmp and the browser reach it. DSW_USER,
# DSW_PASSWORD: the administrator madmp logs in as. SUBMISSION_URL: where DSW
# sends a submitted document, as DSW reaches it. The local values:
#   DSW_API_URL     http://localhost:3000/wizard-api  (docker)
#   DSW_API_URL     http://localhost:8090/wizard-api  (Kubernetes)
#   DSW_USER        madmp-admin@example.com
#   DSW_PASSWORD    openssl rand -hex 24
#   SUBMISSION_URL  http://dmp-api:8081/templates
DSW_API_URL=
DSW_USER=
DSW_PASSWORD=
SUBMISSION_URL=

# --- Stack ---
# STACK_NAME: the compose project or the Kubernetes namespace, lowercase
# letters, digits and -. MADMP_IMAGE, MADMP_TAG: the madmp image the stack
# runs. The local values, the image built from this checkout:
#   STACK_NAME   madmp
#   MADMP_IMAGE  madmp
#   MADMP_TAG    local
STACK_NAME=
MADMP_IMAGE=
MADMP_TAG=

# --- DSW database ---
# The PostgreSQL server of DSW, its database and the account that owns it,
# letters, digits, - and _ only. DSW_POSTGRES_VERSION: the image of the
# stack's server. The local values, the stack's own server:
#   DSW_DB_HOST      dsw-postgres
#   DSW_DB_PORT      5432
#   DSW_DB_NAME      engine-wizard
#   DSW_DB_USER      dsw
#   DSW_DB_PASSWORD  openssl rand -hex 24
DSW_POSTGRES_VERSION=17.5
DSW_DB_HOST=
DSW_DB_PORT=
DSW_DB_NAME=
DSW_DB_USER=
DSW_DB_PASSWORD=

# --- Object storage ---
# The S3 server of DSW's files and its bucket. MINIO_VERSION, MC_VERSION: the
# images of the stack's server and of mc, pgsty builds. S3_URL: the server, as
# the containers and the browser both reach it; the stack's own when its host
# is minio, which needs `127.0.0.1 minio` in /etc/hosts. The account, letters,
# digits, - and _ only. The local values:
#   S3_URL       http://minio:9000  (docker)
#   S3_URL       http://minio:8090  (Kubernetes)
#   S3_BUCKET    engine-wizard
#   S3_USER      minio
#   S3_PASSWORD  openssl rand -hex 24  (8 characters minimum)
MINIO_VERSION=RELEASE.2026-08-04T00-00-00Z
MC_VERSION=RELEASE.2026-09-16T00-00-00Z
S3_URL=
S3_BUCKET=
S3_USER=
S3_PASSWORD=

# --- DSW server ---
# DSW_SERVER_VERSION, DSW_DOCWORKER_VERSION, DSW_CLIENT_VERSION: the tags of
# the server, the document worker and the client, each at its patch, the last
# of the same DSW release.
# DSW_CLIENT_URL: DSW's interface, as the browser reaches it.
# GENERAL_SECRET: the key DSW encrypts its secrets with.
# GENERAL_RSA_PRIVATE_KEY: the key it signs the users' tokens with, on several
# lines between double quotes. The local values:
#   DSW_CLIENT_URL           http://localhost:8080/wizard  (docker)
#   DSW_CLIENT_URL           http://localhost:8090/wizard  (Kubernetes)
#   GENERAL_SECRET           openssl rand -hex 16  (exactly 32 characters)
#   GENERAL_RSA_PRIVATE_KEY  openssl genrsa -traditional 4096
DSW_SERVER_VERSION=4.31.3
DSW_DOCWORKER_VERSION=4.31.0
DSW_CLIENT_VERSION=4.31.0
DSW_CLIENT_URL=
GENERAL_SECRET=
GENERAL_RSA_PRIVATE_KEY=
